datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Tabela: usuarios
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("CLIENT") // Controlar clientes e administradores (ex: CLIENT, ADMIN)
  createdAt DateTime @default(now())

  cartItems Cart[]
  orders    Order[]
}

// 2. Tabela: categorias
model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

// 3. Tabela: produtos
model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  image       String?
  categoryId  Int

  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  Cart[]
  orderItems OrderItem[]
}

// 4. Tabela: carrinho
model Cart {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 5. Tabela: pedidos
model Order {
  id         Int      @id @default(autoincrement())
  userId     Int
  totalValue Decimal  @db.Decimal(10, 2)
  status     String   @default("PENDING") // ex: PENDING, PAID, CANCELED
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
}

// 6. Tabela: itens_pedido
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// 7. Tabela: pagamentos
model Payment {
  id      Int     @id @default(autoincrement())
  orderId Int
  type    String  @default("PIX")
  pixCode String? @db.Text
  status  String  @default("PENDING") // ex: PENDING, APPROVED, REFUNDED

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
